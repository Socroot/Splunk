    "dataSources": {
        "ds_1YM7DbSb": {
            "name": "Search_5",
            "options": {
                "query": "index=sysmon EventCode=3\r\n(\r\n    Image=\"*EXCEL.EXE\"\r\n    OR Image=\"*WINWORD.EXE\"\r\n    OR Image=\"*POWERPNT.EXE\"\r\n    OR Image=\"*OUTLOOK.EXE\"\r\n)\r\n\r\n| eval OfficeProcess=replace(Image,\"^.*\\\\\\\\\",\"\")\r\n\r\n| table _time ComputerName User OfficeProcess DestinationIp DestinationHostname DestinationPort Protocol Initiated\r\n\r\n| sort - _time"
            },
            "type": "ds.search"
        },
        "ds_PgiIv1ff": {
            "name": "Unique Affected Hosts copy 1",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n| stats dc(ComputerName) AS \"Unique Affected Hosts\""
            },
            "type": "ds.search"
        },
        "ds_Qc5tWpHq": {
            "name": "Search_1",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n| timechart span=1h count AS \"Office Child Processes\""
            },
            "type": "ds.search"
        },
        "ds_QvMU8K4q": {
            "name": "Search_4",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n\r\n| eval ParentProcess=replace(ParentImage,\"^.*\\\\\\\\\",\"\")\r\n| eval ChildProcess=replace(Image,\"^.*\\\\\\\\\",\"\")\r\n\r\n| table _time ComputerName ParentUser ParentProcess ChildProcess CommandLine CurrentDirectory IntegrityLevel Hashes ProcessId ParentProcessId\r\n\r\n| sort - _time"
            },
            "type": "ds.search"
        },
        "ds_SD95JigP": {
            "name": "Macro-Enabled Documents Detected",
            "options": {
                "query": "index=sysmon EventCode=11\r\n(\r\n    TargetFilename=\"*.docm\"\r\n    OR TargetFilename=\"*.dotm\"\r\n    OR TargetFilename=\"*.xlsm\"\r\n    OR TargetFilename=\"*.xltm\"\r\n    OR TargetFilename=\"*.potm\"\r\n    OR TargetFilename=\"*.pptm\"\r\n)\r\n| stats count AS \"Macro Documents\""
            },
            "type": "ds.search"
        },
        "ds_Vy4rywhk": {
            "name": "Search_6",
            "options": {
                "query": "index=sysmon EventCode=11\r\n(\r\n    Image=\"*EXCEL.EXE\"\r\n    OR Image=\"*WINWORD.EXE\"\r\n    OR Image=\"*POWERPNT.EXE\"\r\n    OR Image=\"*OUTLOOK.EXE\"\r\n)\r\n\r\n| eval OfficeProcess=replace(Image,\"^.*\\\\\\\\\",\"\")\r\n\r\n| table _time ComputerName User OfficeProcess TargetFilename CreationUtcTime\r\n\r\n| sort - _time"
            },
            "type": "ds.search"
        },
        "ds_ZzNK3aDe": {
            "name": "Unique Affected Hosts",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n| stats dc(ComputerName) AS \"Unique Affected Hosts\""
            },
            "type": "ds.search"
        },
        "ds_acZBEsp3": {
            "name": "Unique Affected Users",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n| stats dc(ParentUser) AS \"Unique Affected Users\""
            },
            "type": "ds.search"
        },
        "ds_awTAnzcT": {
            "name": "Search_3",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n\r\n| eval ParentProcess=replace(ParentImage,\"^.*\\\\\\\\\",\"\")\r\n| eval ChildProcess=replace(Image,\"^.*\\\\\\\\\",\"\")\r\n\r\n| stats count AS \"Execution Count\" by ParentProcess ChildProcess\r\n\r\n| sort -\"Execution Count\""
            },
            "type": "ds.search"
        },
        "ds_sNrUYXX3": {
            "name": "Total Suspicious Macro Events",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n| stats count AS \"Suspicious Macro Events\""
            },
            "type": "ds.search"
        },
        "ds_wzlfPkP1": {
            "name": "Search_7",
            "options": {
                "query": "index=sysmon EventCode=3\r\n(\r\n    Image=\"*powershell.exe\"\r\n    OR Image=\"*pwsh.exe\"\r\n    OR Image=\"*cmd.exe\"\r\n    OR Image=\"*wscript.exe\"\r\n    OR Image=\"*cscript.exe\"\r\n    OR Image=\"*mshta.exe\"\r\n    OR Image=\"*rundll32.exe\"\r\n    OR Image=\"*regsvr32.exe\"\r\n)\r\n\r\n| eval Process=replace(Image,\"^.*\\\\\\\\\",\"\")\r\n\r\n| table _time ComputerName User Process DestinationIp DestinationHostname DestinationPort Protocol Initiated\r\n\r\n| sort - _time"
            },
            "type": "ds.search"
        },
        "ds_zNHKs4oS": {
            "name": "Search_2",
            "options": {
                "query": "index=sysmon EventCode=1\r\n(\r\n    ParentImage=\"*EXCEL.EXE\"\r\n    OR ParentImage=\"*WINWORD.EXE\"\r\n    OR ParentImage=\"*POWERPNT.EXE\"\r\n    OR ParentImage=\"*OUTLOOK.EXE\"\r\n)\r\n| stats count AS Alerts by ComputerName ParentUser\r\n| sort - Alerts"
            },
            "type": "ds.search"
        }
